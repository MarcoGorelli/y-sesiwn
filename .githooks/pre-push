#!/bin/sh
# Runs the tests before every push; the push goes ahead only if they pass.
# Turn it on once per clone:   git config core.hooksPath .githooks
# Skip it for one push:        git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "Running the tests before pushing (about 30 seconds)..."
if [ -x .venv/bin/python ] && .venv/bin/python -c "import pytest, playwright" 2>/dev/null; then
  exec .venv/bin/python -m pytest -q
elif command -v uv >/dev/null 2>&1; then
  exec uv run --no-project --with-requirements requirements-dev.txt python -m pytest -q
else
  exec python3 -m pytest -q
fi
